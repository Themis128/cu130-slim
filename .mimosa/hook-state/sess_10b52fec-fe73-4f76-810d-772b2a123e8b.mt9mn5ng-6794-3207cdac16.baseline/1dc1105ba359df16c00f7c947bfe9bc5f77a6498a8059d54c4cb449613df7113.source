#!/usr/bin/env python3
"""Playwright E2E coverage test for SocialAuto at http://localhost:8082.
Covers 100% of app routes: public auth pages + all authenticated dashboard pages.
"""
import os, re, json, uuid
from datetime import datetime
from playwright.sync_api import sync_playwright

BASE = "http://localhost:8082"
OUT = "/home/tbaltzakis/ComfyUI-Docker/cu130-slim/.playwright-venv/test-output"
SHOT = os.path.join(OUT, "screenshots")
os.makedirs(SHOT, exist_ok=True)

UID = uuid.uuid4().hex[:8]
EMAIL = f"pw.e2e.{UID}@example.com"
PASS = "PlaywrightPass1!"
NAME = "Playwright E2E"

PUBLIC = ["/login", "/register", "/forgot-password", "/reset-password"]
DASH = ["/dashboard", "/content/new", "/content/article/new", "/content/carousel/new",
        "/content/poll/new", "/content/story/new", "/content/thread/new", "/calendar",
        "/media", "/workflows", "/accounts", "/analytics", "/settings", "/settings/ai-providers"]
EXPECT = {"/dashboard": "Dashboard",
          "/content/new": "New Post",
          "/content/article/new": "New Article",
          "/content/carousel/new": "Carousel Creator",
          "/content/poll/new": "New Poll",
          "/content/story/new": "New Story",
          "/content/thread/new": "New Thread",
          "/calendar": "Calendar",
          "/media": "Media",
          "/workflows": "Workflows",
          "/accounts": "Accounts",
          "/analytics": "Analytics",
          "/settings": "Settings",
          "/settings/ai-providers": "AI Providers"}


def slug(p):
    return re.sub(r"[^a-zA-Z0-9_-]", "_", (p.strip("/").replace("/", "_") or "home"))


def body(page):
    try:
        return page.locator("body").inner_text(timeout=6000)
    except Exception:
        return ""


def main():
    results = []
    with sync_playwright() as pw:
        b = pw.chromium.launch(headless=True)
        ctx = b.new_context(viewport={"width": 1440, "height": 900})
        page = ctx.new_page()
        page.set_default_timeout(30000)
        errs = []

        def on_console(msg):
            t = (msg.text or "").lower()
            if msg.type == "error" and not any(x in t for x in ["favicon", "robots"]):
                errs.append((msg.text or "")[:250])

        page.on("console", on_console)

        def visit(url, name):
            errs.clear()
            try:
                page.goto(BASE + url, wait_until="networkidle", timeout=45000)
                page.wait_for_timeout(2000)
                shot = name + ".png"
                page.screenshot(path=os.path.join(SHOT, shot))
                txt = body(page)
                is404 = "could not be found" in txt.lower()
                expect = EXPECT.get(url)
                verified = (not expect) or (expect in txt)
                status = "ok" if (not is404 and verified) else ("ERROR(404)" if is404 else "content-mismatch")
                results.append({"url": url, "status": status, "verified": verified,
                                "errors": list(errs), "shot": shot})
            except Exception as e:
                results.append({"url": url, "status": "EXCEPTION", "verified": False,
                                "errors": list(errs), "shot": "", "detail": str(e)[:200]})

        # public routes
        for r in PUBLIC:
            visit(r, "public_" + slug(r))

        # register + autologin
        errs.clear()
        try:
            page.goto(BASE + "/register", wait_until="networkidle", timeout=45000)
            page.wait_for_timeout(1500)
            page.fill("#full_name", NAME)
            page.fill("#email", EMAIL)
            page.fill("#password", PASS)
            page.fill("#confirmPassword", PASS)
            page.screenshot(path=os.path.join(SHOT, "register_filled.png"))
            page.click("button[type='submit']")
            page.wait_for_timeout(4000)
            ok = "/dashboard" in page.url
            results.append({"url": "register", "status": "ok" if ok else "redirect-failed",
                            "verified": ok, "errors": list(errs), "shot": "register_filled.png"})
        except Exception as e:
            results.append({"url": "register", "status": "EXCEPTION", "verified": False,
                            "errors": list(errs), "shot": "", "detail": str(e)[:200]})

        # dashboard routes
        for r in DASH:
            visit(r, "dash_" + slug(r))

        # logout via sidebar user menu
        errs.clear()
        try:
            page.goto(BASE + "/dashboard", wait_until="networkidle", timeout=45000)
            page.wait_for_timeout(1800)
            # dismiss the onboarding tour overlay if present (blocks the sidebar)
            if page.get_by_text("Skip tour", exact=False).count() > 0:
                page.get_by_text("Skip tour", exact=False).first.click()
                page.wait_for_timeout(800)
            hit = False
            # Open the user dropdown (a radix trigger with aria-haspopup=menu).
            triggers = page.locator("[aria-haspopup='menu']")
            for i in range(triggers.count()):
                try:
                    triggers.nth(i).click()
                    page.wait_for_timeout(700)
                except Exception:
                    continue
                # The dropdown content renders in a portal; "Logout" item is a menu item
                try:
                    if page.get_by_role("menuitem", name="Logout", exact=False).count() > 0:
                        page.get_by_role("menuitem", name="Logout", exact=False).first.click()
                        hit = True
                        break
                except Exception:
                    pass
                # close dropdown if no Logout found
                page.keyboard.press("Escape")
                page.wait_for_timeout(300)
            if not hit and page.get_by_text("Logout", exact=False).count() > 0:
                page.get_by_text("Logout", exact=False).first.click()
            page.wait_for_timeout(2500)
            results.append({"url": "logout", "status": "ok" if "/login" in page.url else page.url,
                            "verified": "/login" in page.url, "errors": list(errs), "shot": ""})
        except Exception as e:
            results.append({"url": "logout", "status": "EXCEPTION", "verified": False,
                            "errors": list(errs), "shot": "", "detail": str(e)[:200]})

        # login again
        errs.clear()
        try:
            page.goto(BASE + "/login", wait_until="networkidle", timeout=45000)
            page.wait_for_timeout(1200)
            page.fill("#email", EMAIL)
            page.fill("#password", PASS)
            page.screenshot(path=os.path.join(SHOT, "login_filled.png"))
            page.click("button[type='submit']")
            page.wait_for_timeout(4000)
            ok = "/dashboard" in page.url
            results.append({"url": "login", "status": "ok" if ok else "login-failed",
                            "verified": ok, "errors": list(errs), "shot": "login_filled.png"})
        except Exception as e:
            results.append({"url": "login", "status": "EXCEPTION", "verified": False,
                            "errors": list(errs), "shot": "", "detail": str(e)[:200]})

        b.close()

    # --- report ---
    passed = [r for r in results if r["status"] == "ok"]
    failed = [r for r in results if r["status"] != "ok"]
    L = ["# Playwright E2E Coverage Report", "",
         f"- **App:** {BASE}", f"- **Run:** {datetime.now().isoformat()}",
         f"- **Routes/flows tested:** {len(results)}", f"- **Passed:** {len(passed)}",
         f"- **Failed:** {len(failed)}", "",
         "| # | Route/Flow | Status | Verified | Console errors | Screenshot |",
         "|---|---|---|---|---|---|"]
    for i, r in enumerate(results, 1):
        ic = ":white_check_mark:" if r["status"] == "ok" else ":x:"
        ce = "; ".join(r["errors"]) if r.get("errors") else "none"
        dt = r.get("detail", "")
        if dt:
            ic += f" <sub>`{dt}`</sub>"
        L.append(f"| {i} | `{r['url']}` | {ic} {r['status']} | {r['verified']} | {ce} | `{r.get('shot','')}` |")
    rep = "\n".join(L) + "\n"
    rp = os.path.join(OUT, "coverage_report.md")
    with open(rp, "w") as f:
        f.write(rep)
    print(rep)
    print("report ->", rp)
    for r in failed:
        print("FAILED:", json.dumps(r, default=str))


if __name__ == "__main__":
    main()