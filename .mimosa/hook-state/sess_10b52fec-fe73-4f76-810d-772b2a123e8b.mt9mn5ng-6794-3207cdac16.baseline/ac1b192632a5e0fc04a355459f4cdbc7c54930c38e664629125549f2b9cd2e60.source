import json, uuid
from playwright.sync_api import sync_playwright

API = "http://localhost:8083/api/v1"
U = uuid.uuid4().hex[:6]
EMAIL = f"pw.500.{U}@example.com"
PASS = "PlaywrightPass1!"

with sync_playwright() as pw:
    b = pw.chromium.launch(headless=True)
    r = b.new_context().request
    r.post(f"{API}/auth/register", data={"email": EMAIL, "password": PASS, "name": "500 Probe"})
    tok = (r.post(f"{API}/auth/login", form={"username": EMAIL, "password": PASS}).json() or {}).get("access_token")
    H = {"Authorization": f"Bearer {tok}"}

    print("overview BEFORE:", r.get(f"{API}/analytics/overview?days=30", headers=H).status)
    resp = r.post(f"{API}/content/posts", headers=H, data={
        "content_text": "draft without targets",
        "status": "draft"})
    pid = resp.json().get("id") if resp.ok else None
    print("created draft:", resp.status, pid)
    st = r.get(f"{API}/analytics/overview?days=30", headers=H).status
    print("overview AFTER draft:", st)

    # scheduled post too
    from datetime import datetime, timedelta, timezone
    sched = (datetime.now(timezone.utc) + timedelta(days=2)).strftime("%Y-%m-%dT%H:%M:%S+00:00")
    resp = r.post(f"{API}/content/posts", headers=H, data={
        "content_text": "scheduled without targets", "scheduled_at": sched, "status": "scheduled"})
    print("created scheduled:", resp.status)
    print("overview AFTER scheduled:", r.get(f"{API}/analytics/overview?days=30", headers=H).status)
    print("top-posts:", r.get(f"{API}/analytics/top-posts?limit=5", headers=H).status)
    print("engagement:", r.get(f"{API}/analytics/engagement?days=30", headers=H).status)
    print("platforms:", r.get(f"{API}/analytics/platforms?days=30", headers=H).status)
    if pid:
        print("post-analytics:", r.get(f"{API}/analytics/posts/{pid}", headers=H).status)
    b.close()