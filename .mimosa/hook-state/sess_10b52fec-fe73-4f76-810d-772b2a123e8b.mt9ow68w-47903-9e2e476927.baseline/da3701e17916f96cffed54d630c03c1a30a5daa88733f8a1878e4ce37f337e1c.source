import json, uuid
from playwright.sync_api import sync_playwright

BASE = "http://localhost:8082"
UID = uuid.uuid4().hex[:8]
EMAIL = f"pw.detail.{UID}@example.com"
PASS = "PlaywrightPass1!"
NAME = "Alba Vega"

with sync_playwright() as pw:
    b = pw.chromium.launch(headless=True)
    p = b.new_page()
    p.set_default_timeout(20000)
    captured = {}
    def on_resp(r):
        if "/auth/register" in r.url:
            try:
                captured["body"] = r.text()
            except Exception:
                pass
            captured["status"] = r.status
            try:
                captured["req"] = r.request.post_data
            except Exception:
                pass
    p.on("response", on_resp)

    # replicate spec02 leftovers then spec03
    p.goto(BASE + "/register", wait_until="networkidle", timeout=45000)
    p.wait_for_timeout(900)
    p.get_by_role("button", name="Create account").first.click()   # empty submit errors
    p.wait_for_timeout(600)
    p.fill("#full_name", NAME)
    p.fill("#email", EMAIL)
    p.fill("#password", "short")
    p.get_by_role("button", name="Create account").first.click()   # short pw error
    p.wait_for_timeout(600)
    p.fill("#password", PASS)
    p.fill("#confirmPassword", "different-pass-123")
    p.get_by_role("button", name="Create account").first.click()   # mismatch error
    p.wait_for_timeout(600)

    # spec03: fresh register page, fill valid, submit
    p.goto(BASE + "/register", wait_until="networkidle", timeout=45000)
    p.wait_for_timeout(900)
    p.fill("#full_name", NAME)
    p.fill("#email", EMAIL)
    p.fill("#password", PASS)
    p.fill("#confirmPassword", PASS)
    p.get_by_role("button", name="Create account", exact=True).first.click()
    p.wait_for_timeout(5000)
    print("URL:", p.url)
    print("CAPTURED:", json.dumps(captured, indent=2)[:800])
    b.close()