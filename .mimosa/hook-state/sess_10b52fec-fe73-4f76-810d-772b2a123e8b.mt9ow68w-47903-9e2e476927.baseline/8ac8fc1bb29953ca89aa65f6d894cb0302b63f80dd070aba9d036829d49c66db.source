    for pl in ["LinkedIn", "Twitter / X", "Instagram", "Facebook", "Threads"]:
        s.ok_if(get_text(page, pl), f"platform selector '{pl}' present")

    s.ok_if(get_text(page, "Need to connect accounts", timeout=9000), "hint 'Need to connect accounts?' visible")
    # platform selectors are disabled without connected accounts
    disabled_count = page.locator("button[disabled]").count()
    s.ok_if(disabled_count >= 4,
            f"platform selectors disabled without accounts ({disabled_count} disabled buttons)")

    s.ok_if(get_placeholder(page, "What do you want to share?"), "composer textarea present")
    page.get_by_placeholder("What do you want to share?").fill("Hello from the Playwright E2E suite!")
    s.ok_if(get_text(page, "Hello from the Playwright E2E suite!"), "typed content rendered")

    s.ok_if(get_text(page, "Save Draft"), "'Save Draft' button")
    s.ok_if(get_text(page, "Schedule"), "'Schedule' button")
    s.ok_if(get_text(page, "Publish Now"), "'Publish Now' button")

