def spec_calendar(page, s):
    """Calendar grid, month navigation and day-selection detail panel."""
    go(page, "/calendar")
    s.ok_if(get_heading(page, "Calendar"), "h1 'Calendar' visible")
    for d in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]:
        s.ok_if(get_text(page, d), f"day header '{d}'")
    s.ok_if(get_text(page, "Drag a post chip to a new date to reschedule it"), "legend hint visible")

    month_btn = page.locator("button").filter(has=page.locator("svg.lucide-chevron-right"))
    prev_btn = page.locator("button").filter(has=page.locator("svg.lucide-chevron-left"))
    label = page.locator("button").filter(has_text=re.compile(r"[A-Z][a-z]+ \d{4}")).first
    try:
        m0 = label.inner_text()
    except Exception:
        m0 = ""
    if m0:
        s.ok("current month label shown: " + m0)
    else:
        s.fail("current month label shown")
    month_btn.first.click()
    page.wait_for_timeout(700)
    try:
        m1 = label.inner_text()
        s.ok_if(m1 != m0, f"next-month nav changes label ({m0} -> {m1})")
    except Exception:
        s.fail("next-month nav changes label")
    prev_btn.first.click()
    page.wait_for_timeout(700)

    day_num = datetime.now().day
    try:
        page.get_by_text(str(day_num), exact=True).first.click()
        page.wait_for_timeout(700)
        s.ok_if(get_text(page, "Nothing scheduled"), "day detail shows 'Nothing scheduled'")
    except Exception as e:
        s.fail("day detail shows 'Nothing scheduled'", str(e)[:120])
    dump(page, s, "final")


