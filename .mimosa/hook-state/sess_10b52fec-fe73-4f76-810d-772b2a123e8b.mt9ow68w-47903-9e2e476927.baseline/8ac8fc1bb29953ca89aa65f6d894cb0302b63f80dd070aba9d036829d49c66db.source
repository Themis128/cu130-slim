#!/usr/bin/env python3
"""Detailed Playwright E2E suite for SocialAuto at http://localhost:8082.

Goes beyond "does the page load" — it exercises real flows:
  - client-side form validation on auth pages
  - registration + auto-login
  - dashboard rendering, sidebar nav, collapse/expand
  - content composer + Schedule dialog
  - all content-type creators (article/carousel/poll/story/thread)
  - calendar interactions (month nav, day selection)
  - media library dialogs
  - workflows tabs + AI generation form
  - accounts tabs + setup guide
  - analytics chart cards and period selector
  - settings: profile update, password validation, theme switching, danger zone
  - AI providers catalog
  - logout / login (wrong + right credentials)
  - full forgot-password -> reset-password loop with new password login

Each step is recorded, plus HTTP 4xx/5xx responses and browser console errors.
"""
import os
import re
import json
