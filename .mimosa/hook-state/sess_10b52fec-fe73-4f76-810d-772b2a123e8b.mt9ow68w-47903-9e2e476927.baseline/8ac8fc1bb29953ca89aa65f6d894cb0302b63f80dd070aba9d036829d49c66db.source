def spec_settings_profile(page, s):
    """Settings profile tab prefills user data and persists an update."""
    go(page, "/settings")
    s.ok_if(get_heading(page, "Settings"), "h1 'Settings' visible")
    for tab in ["Profile", "Security", "Notifications", "Appearance", "Danger Zone"]:
        s.ok_if(get_text(page, tab, exact=True), f"settings tab '{tab}'")
    s.ok_if(get_text(page, "AI Providers"), "'AI Providers' shortcut button")

    # profile form prefilled with registered user
    full = page.locator("#full_name")
    email = page.locator("#email")
    try:
        s.ok_if(full.input_value() == NAME, "profile full name prefilled")
        s.ok_if(email.input_value() == EMAIL, "profile email prefilled")
        s.ok_if(NAME in page.locator("aside").inner_text(), "sidebar shows registered name")
    except Exception as e:
        s.fail("profile prefill", str(e)[:150])

    full.fill("Alba Vega Updated")
    page.get_by_role("button", name="Save Changes").click()
    profile_ok = get_text(page, "Profile updated", timeout=12000)
    s.ok_if(profile_ok, "profile save shows 'Profile updated' toast")
    try:
        s.ok_if("Updated" in page.locator("aside").inner_text(), "sidebar reflects updated name")
    except Exception:
        s.fail("sidebar reflects updated name")

    # Security tab: change-password form validates mismatches
    page.get_by_role("tab", name="Security").click()
    page.wait_for_timeout(700)
    for field in ["#current_password", "#new_password", "#confirm_password"]:
        try:
            page.fill(field, "nope")
        except Exception:
            pass
    page.fill("#current_password", PASS)
    page.fill("#new_password", "BrandNewPass1!")
    page.fill("#confirm_password", "BrandNewPass1!!")
    page.get_by_role("button", name="Change Password").click()
    s.ok_if(get_text(page, "Passwords do not match", timeout=12000), "password mismatch rejected in Security tab")
    dump(page, s, "final")


def spec_settings_appearance(page, s):
    """Settings: theme switching and danger zone presence."""
    go(page, "/settings")
    page.get_by_role("tab", name="Appearance").click()
    page.wait_for_timeout(900)
    for theme_btn in ["Light", "Dark", "System"]:
        s.ok_if(get_text(page, theme_btn), f"appearance option '{theme_btn}'")

    # accessible names are lowercase ('light' / 'dark' / 'system')
    page.get_by_role("button", name="dark", exact=True).click()
    page.wait_for_timeout(600)
    is_dark = False
    try:
        is_dark = page.evaluate("() => document.documentElement.classList.contains('dark')")
    except Exception:
        pass
    s.ok_if(is_dark, "Dark theme toggles `dark` class on <html>")
    page.get_by_role("button", name="light", exact=True).click()
    page.wait_for_timeout(600)
    is_dark = False
    try:
        is_dark = page.evaluate("() => document.documentElement.classList.contains('dark')")
    except Exception:
        pass
    s.ok_if(not is_dark, "Light theme removes `dark` class")

    page.get_by_role("tab", name="Danger Zone").click()
    page.wait_for_timeout(800)
    s.ok_if(get_text(page, "Delete Account"), "'Delete Account' present")
    s.ok_if(get_text(page, "Request Data Export"), "'Request Data Export' present")
    dump(page, s, "final")


