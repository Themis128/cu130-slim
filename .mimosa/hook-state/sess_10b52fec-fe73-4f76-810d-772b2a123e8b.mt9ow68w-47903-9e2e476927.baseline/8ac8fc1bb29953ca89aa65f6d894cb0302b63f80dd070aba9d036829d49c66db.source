    s.ok_if(get_text(page, "Generate"), "'Generate' AI button present")
    dump(page, s, "final")


def _check_creator(page, s, path, heading, placeholders):
    go(page, path)
    s.ok_if(get_heading(page, heading), f"h1 '{heading}' visible")
    for ph in placeholders:
        s.ok_if(get_placeholder(page, ph), f"placeholder '{ph}' present")
    dump(page, s, heading.replace(" ", "_").lower())


def spec_creators(page, s):
