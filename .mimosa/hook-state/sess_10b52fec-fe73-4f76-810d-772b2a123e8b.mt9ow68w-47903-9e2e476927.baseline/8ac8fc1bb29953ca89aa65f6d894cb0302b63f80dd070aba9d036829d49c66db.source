API_BASE = "http://localhost:8083/api/v1"
API_SESSION = {"api": None}


class Api:
    """Direct backend access used to seed state the UI must reflect."""

    def __init__(self, ctx):
        self.r = ctx.request
        self.token = None

    def register(self, email, password, name="E2E Seeded"):
        """Best-effort user creation; safe to call even if the user exists."""
        self.r.post(f"{API_BASE}/auth/register",
                    data={"email": email, "password": password, "name": name})

    def login(self, email, password):
        resp = self.r.post(f"{API_BASE}/auth/login",
                           form={"username": email, "password": password})
        self.token = (resp.json() or {}).get("access_token", "")
        return bool(self.token)

    def ensure_session(self, email, password):
        """Login if not already holding a token."""
        if self.token:
            return True
        return self.login(email, password)

    def _h(self):
        return {"Authorization": f"Bearer {self.token}"}

    def create_post(self, text, scheduled_at=None, status=None):
        payload = {"content_text": text}
        if scheduled_at:
            payload["scheduled_at"] = scheduled_at
        if status:
            payload["status"] = status
        resp = self.r.post(f"{API_BASE}/content/posts",
                           headers=self._h(), data=payload)
        return resp.json() if resp.ok else None

    def duplicate_post(self, post_id):
        resp = self.r.post(f"{API_BASE}/content/posts/{post_id}/duplicate",
                           headers=self._h())
        return resp.json() if resp.ok else None

    def upload_media(self, filename, png_bytes):
        resp = self.r.post(f"{API_BASE}/media/upload", headers=self._h(),
                           multipart={
                               "file": {"name": filename,
                                        "mimeType": "image/png",
                                        "buffer": png_bytes},
                               "alt_text": "e2e seeded image",
                           })
        return resp.json() if resp.ok else None

    def create_template(self, name):
        resp = self.r.post(f"{API_BASE}/workflows/templates", headers=self._h(),
                           data={
                               "name": name,
                               "description": "seeded by e2e suite",
                               "prompt_template": "Post {content} to socials",
                               "n8n_workflow_json": {"nodes": [], "connections": {}},
                           })
        return resp.json() if resp.ok else None

    def get_post(self, post_id):
        resp = self.r.get(f"{API_BASE}/content/posts/{post_id}", headers=self._h())
        data = resp.json() if resp.ok else None
        return data.get("data", data) if isinstance(data, dict) else data

    def list_posts(self):
        resp = self.r.get(f"{API_BASE}/content/posts", headers=self._h())
        data = resp.json() if resp.ok else []
        return data if isinstance(data, list) else data.get("items") or []

    def me(self):
        resp = self.r.get(f"{API_BASE}/auth/me", headers=self._h())
        return resp.json() if resp.ok else {}

    def delete_account(self, account_id):
        return self.r.delete(f"{API_BASE}/accounts/{account_id}",
                             headers=self._h()).status


# Fernet key derivation must match backend app/core/security.py
ENCRYPTION_KEY = "your-32-byte-encryption-key-here!!"


def seed_connected_account(team_id: str, uid: str):
    """Insert a LinkedIn social account row with a validly-encrypted token.

    The composer only enables platform selection for connected accounts and the
    connect endpoint requires real OAuth, so the write-path tests seed a row
    directly into Postgres with a token encrypted exactly like the backend does.
    Returns (account_id, db_row_account_id) or (None, None) on failure.
    """
    import base64
    import subprocess
    from cryptography.fernet import Fernet

    # replicate backend get_fernet() padding exactly
    key = ENCRYPTION_KEY.encode()
    key = key.ljust(32, b"0")[:32]
    enc_hex = Fernet(base64.urlsafe_b64encode(key)).encrypt(
        b"e2e-dummy-access-token").hex()
    acct_id = f"e2e-acct-{uid}"
    sql = (
        "INSERT INTO social_accounts (team_id, platform, account_id, username, "
        "display_name, access_token_enc, status) VALUES "
        f"('{team_id}','linkedin','{acct_id}','e2e_user','E2E Test Account',"
        f"decode('{enc_hex}','hex'),'active') RETURNING id;"
    )
    try:
        out = subprocess.run(
            ["docker", "exec", "social-postgres", "psql", "-U", "postgres",
             "-d", "social", "-tAc", sql],
            capture_output=True, text=True, timeout=30)
    except Exception:
        return None, None
    row_id = out.stdout.strip()
    return (row_id or None), (acct_id if row_id else None)


def slugify(s: str) -> str:
    return re.sub(r"[^a-zA-Z0-9_-]", "_", s.strip().lower().replace(" ", "_")) or "spec"


class Spec:
    """Collects granular steps for a single spec and yields a report section."""

    def __init__(self, name):
        self.name = name
        self.steps = []
        self.allowed_http = set()
        self.allowed_url_patterns = []

    def allow_http(self, *codes):
        self.allowed_http.update(int(c) for c in codes)

    def ignore_http_404(self, url_substring):
        """Documented deployed-build defect: don't fail on this specific 404."""
        self.allowed_url_patterns.append(url_substring)

    def _http_allowed(self, status, url):
        if status in self.allowed_http:
            return True
        return any(sub in url for sub in self.allowed_url_patterns)

    def _add(self, label, ok, detail=""):
        self.steps.append({"label": label, "ok": bool(ok), "detail": detail})
        print(f"   [{'PASS' if ok else 'FAIL'}] {label}" + (f" — {detail}" if detail else ""))

    def ok(self, label, detail=""):
        self._add(label, True, detail)

    def ok_if(self, cond, label, detail=""):
        self._add(label, bool(cond), detail)

    def fail(self, label, detail=""):
        self._add(label, False, detail)

    @property
    def passed(self):
        return all(s["ok"] for s in self.steps)


def is_visible(page, loc, timeout=10000):
    """True if the given CSS XPath-like locator is rendered visible."""
    try:
        page.locator(loc).first.wait_for(state="visible", timeout=timeout)
        return True
    except Exception:
        return False


def get_text(page, text, timeout=10000, exact=False):
    """True if text is visible on the page."""
    try:
        page.get_by_text(text, exact=exact).first.wait_for(state="visible", timeout=timeout)
        return True
    except Exception:
        return False


def get_placeholder(page, ph, timeout=10000):
    try:
        page.get_by_placeholder(ph).first.wait_for(state="visible", timeout=timeout)
        return True
    except Exception:
        return False


def get_heading(page, name, timeout=10000):
    try:
        page.get_by_role("heading", name=name).first.wait_for(state="visible", timeout=timeout)
        return True
    except Exception:
        return False


def go(page, path, quiet=600):
    page.goto(BASE + path, wait_until="networkidle", timeout=45000)
    page.wait_for_timeout(quiet)


def has_class(page, el, cls):
    try:
        return el in " ".join(page.eval_on_selector("%s" % "", "(e) => e.className")) if False else False
    except Exception:
        return False


def skip_tour(page):
    try:
        if page.get_by_text("Skip tour", exact=True).count() > 0:
            page.get_by_text("Skip tour", exact=True).first.click()
            page.wait_for_timeout(700)
    except Exception:
        pass


def click_bt(page, label, exact=False):
    page.get_by_role("button", name=label, exact=exact).first.click()
    page.wait_for_timeout(600)


PNG_1PX = bytes.fromhex(
    "89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c489"
    "0000000d49444154789c626001000000ffff03000006000557bfabd40000000049454e44ae426082"
)


def stat_value(page, label):
    """Read the numeric value rendered inside the stat card labelled `label`."""
    return page.evaluate(
        """(label) => {
          const els = Array.from(document.querySelectorAll('*'));
          const el = els.find(e => e.childElementCount === 0 &&
                                   e.textContent.trim() === label);
          if (!el) return null;
          let node = el.parentElement;
          for (let i = 0; i < 6 && node; i++) {
            const nums = Array.from(node.querySelectorAll('*')).filter(x =>
              x.childElementCount === 0 && /^\\d+$/.test(x.textContent.trim()));
            if (nums.length) return nums[nums.length - 1].textContent.trim();
            node = node.parentElement;
          }
          return null;
        }""", label)


def dump(page, spec, tag):
    try:
        page.screenshot(path=os.path.join(SHOT_DIR, f"{slugify(spec.name)}_{tag}.png"))
    except Exception:
        pass


