        page.get_by_role("link", name="New Post").first.click()
        page.wait_for_timeout(800)
        s.ok_if(page.url.endswith("/content/new"), "'New Post' header action navigates to /content/new")
    except Exception as e:
        s.fail("'New Post' header action navigates to /content/new", str(e)[:150])
