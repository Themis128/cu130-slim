def spec_scheduled_post_calendar_edit(page, s):
    """Seeded scheduled post shows on the calendar and opens prefilled in edit page."""
    api = API_SESSION["api"]
    if not api.ensure_session(EMAIL, PASS):
        s.fail("API session established for seeding")
        return
    # deployed-build defect: the edit page fetches /analytics/posts/{id} for
    # unpublished posts, which 404s — documented, does not fail the spec
    s.ignore_http_404("/analytics/posts/")
    from datetime import timedelta
    target = datetime.now() + timedelta(days=1)
    sched_iso = target.strftime("%Y-%m-%dT%H:%M:%S+00:00")
    text = f"E2E scheduled post {UID}"
    created = api.create_post(text, scheduled_at=sched_iso, status="scheduled")
    s.ok_if(bool(created and created.get("id")), "scheduled post seeded via API")

    go(page, "/calendar")
    # if tomorrow falls in the next month, advance the calendar first
    if target.month != datetime.now().month:
        nxt = page.locator("button").filter(has=page.locator("svg.lucide-chevron-right"))
        nxt.first.click()
        page.wait_for_timeout(700)

    day_num = str(target.day)
    try:
        page.get_by_text(day_num, exact=True).first.click()
        page.wait_for_timeout(800)
        s.ok_if(get_text(page, text), "day detail panel lists the scheduled post")
    except Exception as e:
        s.fail("day detail panel lists the scheduled post", str(e)[:120])

    # the post chip links to the edit page — follow it
    chip = page.locator(f'a[href="/content/{created["id"]}/edit"]')
    if chip.count() > 0:
        chip.first.click()
        page.wait_for_timeout(2000)
        s.ok_if(f"/content/{created['id']}/edit" in page.url,
                "post chip opens the edit page")
        val = ""
        try:
            val = page.locator("textarea").first.input_value()
        except Exception:
            pass
        s.ok_if(val == text, "edit page textarea prefilled with scheduled content",
                f"value={val[:60]!r}")
        for btn in ["Save Draft", "Schedule", "Publish Now"]:
            s.ok_if(get_text(page, btn), f"edit page '{btn}' action present")
    else:
        s.fail("post chip opens the edit page", "chip link not found")
    dump(page, s, "final")


def spec_dashboard_counts_seeded(page, s):
    """Dashboard stat cards reflect the posts seeded through the API."""
    api = API_SESSION["api"]
    d1 = api.create_post(f"E2E draft A {UID}", status="draft")
    d2 = api.create_post(f"E2E draft B {UID}", status="draft")
    s.ok_if(bool(d1 and d2), "two draft posts seeded via API")

    go(page, "/dashboard")
    skip_tour(page)
    total = stat_value(page, "Total Posts")
    sched = stat_value(page, "Scheduled")
    drafts = stat_value(page, "Drafts") or stat_value(page, "Draft posts")
    s.ok_if(total == "3", f"'Total Posts' card shows 3 (got {total})")
    s.ok_if(sched == "1", f"'Scheduled' card shows 1 (got {sched})")
    if drafts is not None:
        s.ok_if(drafts == "2", f"draft count shows 2 (got {drafts})")
    dump(page, s, "final")


def spec_media_lifecycle(page, s):
    """Uploaded media renders in the grid; delete is undoable."""
    api = API_SESSION["api"]
    # deployed-build defect: thumbnails resolve to /undefined/uploads/... because
    # NEXT_PUBLIC_API_URL is not baked into the image — documented, not a failure
    s.ignore_http_404("/undefined/uploads/")
    fname = f"e2e-{UID}.png"
    up = api.upload_media(fname, PNG_1PX)
    s.ok_if(bool(up and up.get("id")), "media asset uploaded via API")

    go(page, "/media")
    img = page.locator(f'img[alt="{fname}"]')
    try:
        img.wait_for(state="visible", timeout=15000)
        s.ok("uploaded image thumbnail visible in library grid")
    except Exception:
        s.fail("uploaded image thumbnail visible in library grid")

    tile = page.locator("div.group").filter(has=img)
    deleted_toast = False
    try:
        tile.first.hover()
        tile.first.locator("button").first.click()
        page.wait_for_timeout(900)
        deleted_toast = get_text(page, "deleted", timeout=4000)
        s.ok_if(deleted_toast and get_text(page, "Undo", timeout=3000),
                "delete triggers undo toast with Undo action")
    except Exception as e:
        s.fail("delete triggers undo toast with Undo action", str(e)[:150])

    if deleted_toast:
        try:
            page.get_by_role("button", name="Undo").click()
            page.wait_for_timeout(900)
            s.ok_if(img.count() > 0, "Undo restores the deleted media item")
        except Exception as e:
            s.fail("Undo restores the deleted media item", str(e)[:120])

    # client-side search filtering
    search = page.get_by_placeholder("Search media...")
    search.fill("zzz-no-such-asset")
    page.wait_for_timeout(700)
    s.ok_if(img.count() == 0, "non-matching search hides the asset")
    search.fill("")
    page.wait_for_timeout(700)
    s.ok_if(img.count() > 0, "clearing search restores the asset")
    dump(page, s, "final")


