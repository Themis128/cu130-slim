    s.ok_if(get_text(page, "Connected Accounts"), "stat card 'Connected Accounts'")
    s.ok_if(get_text(page, "Top Performing Posts"), "Top Performing Posts section")
    s.ok_if(get_text(page, "Quick Actions"), "Quick Actions section")

    for item in ["Dashboard", "Content", "Calendar", "Media Library",
                 "Workflows", "Accounts", "Analytics", "Settings"]:
        s.ok_if(get_text(page, item), f"sidebar link '{item}'")

