        s.ok_if(get_text(page, card, timeout=15000), f"metric card '{card}'")
    for sec in ["Engagement Over Time", "Platform Performance", "Top Performing Posts"]:
        s.ok_if(get_text(page, sec, timeout=12000), f"section '{sec}' present")
    s.ok_if(get_text(page, "No data for this period", timeout=10000), "top-posts empty state")

    # open the period selector by clicking its visible value, then pick 7 days
    try:
        page.get_by_text("Last 30 days", exact=True).first.click()
        page.wait_for_timeout(700)
    except Exception:
        page.get_by_role("combobox").first.click()
        page.wait_for_timeout(700)
    page.get_by_text("Last 7 days", exact=True).last.click()
    page.wait_for_timeout(1000)
    s.ok_if(get_text(page, "Last 7 days"), "period selector switches to 'Last 7 days'")

    # Export is a documented stub in the deployed build
    page.get_by_role("button", name="Export", exact=True).click()
    s.ok_if(get_text(page, "Export coming soon", timeout=6000),
            "'Export' shows stub toast 'Export coming soon'")
    dump(page, s, "final")


