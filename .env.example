# =============================================================================
# QUICK START: generate a development .env with random defaults by running
#   python3 scripts/generate-env-secrets.py > .env
# Then manually add the real platform credentials listed at the bottom.
# =============================================================================

# =============================================================================
# CORE SERVICES - Database & Cache
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Metabase (uses same postgres instance)
METABASE_DB_USER=metabase
METABASE_DB_PASS=metabase_password
METABASE_DB_DBNAME=metabase
METABASE_DB_PORT=5432
MB_EMAIL=admin@example.com
MB_PASSWORD=metabase_admin_password
# Existing postgres_data volumes keep their initialized password. Change the
# password in PostgreSQL before updating this value on an existing deployment.

# Social Automation database (social-postgres service)
SOCIAL_POSTGRES_USER=social_user
SOCIAL_POSTGRES_PASSWORD=social_password
SOCIAL_POSTGRES_DB=social_automation
# Existing social_postgres_data volumes keep their initialized password. Change
# the password in PostgreSQL before updating this value on an existing deploy.

# N8N Workflow Engine
N8N_ENCRYPTION_KEY=your-32-char-encryption-key-here!!
N8N_USER=admin
N8N_PASSWORD=secure_password
N8N_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Redis
REDIS_PASSWORD=redis_password

# =============================================================================
# AI SERVICES
# =============================================================================
COMFYUI_PORT=8000
OLLAMA_PORT=11434
CHROMA_PORT=8001

# MinIO (S3-compatible local storage — failover between R2 and local disk)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=social-media

# =============================================================================
# FRONTEND PORTS
# =============================================================================
PORTAL_PORT=3000
PORTAL_API_PORT=8080
ENV_MANAGER_PORT=8081
ENV_MANAGER_USER=admin
ENV_MANAGER_PASS=change_me

# =============================================================================
# SOCIAL AUTOMATION PLATFORM
# =============================================================================
# Security (generate with: openssl rand -base64 32)
SECRET_KEY=your-super-secret-key-min-32-chars
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars

# Admin user (for initial setup)
SOCIAL_ADMIN_EMAIL=admin@example.com
SOCIAL_ADMIN_PASSWORD=secure_admin_password
SOCIAL_ADMIN_NAME=Admin User

# Slack daily digest → #socialauto (C0BT263L17U)
# Create Incoming Webhook: Slack → Apps → Incoming Webhooks → add to #socialauto
SLACK_WEBHOOK_URL=
# Or use a bot token instead of webhook:
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0BT263L17U
SLACK_DIGEST_HOUR=9
SOCIALAUTO_DIGEST_DAYS=1

# Database
DATABASE_URL=postgresql+asyncpg://social_user:social_password@social-postgres:5432/social_automation

# Redis
REDIS_URL=redis://:redis_password@redis:6379/0

# Service URLs (internal Docker network)
N8N_URL=http://n8n:5678
COMFYUI_URL=http://comfyui:8000
OLLAMA_URL=http://ollama:11434
CHROMA_URL=http://chroma:8000
LOCAL_NIM_URL=http://stable-diffusion-nim:8000/v1/infer

# External AI APIs (optional)
FAL_KEY=
REPLICATE_API_TOKEN=

# Cloudflare Workers AI (LLM, image gen, and Whisper speech-to-text)
# Free tier: 10,000 Neurons/day shared across all Workers AI models.
# Recommended models: @cf/meta/llama-3.3-70b-instruct-fp8-fast (text),
#                     @cf/black-forest-labs/flux-1-schnell (images, 4 steps)
# Token: https://dash.cloudflare.com/profile/api-tokens
#   Required permissions for inference: Account -> Workers AI -> Read + Run
#   (Workers AI Edit alone is NOT enough to call /ai/run.)
#   Use the "Create a Workers AI API Token" template from the Workers AI
#   dashboard page for a token that is guaranteed to have inference rights.
# Account ID: dashboard → right sidebar → "Account ID"
# Pricing: https://developers.cloudflare.com/workers-ai/platform/pricing/
CLOUDFLARE_API_TOKEN=
# Optional separate token for Workers AI inference only. If set, this is used
# for /ai/run calls instead of CLOUDFLARE_API_TOKEN. Useful when the main
# token has R2/zone permissions but not Workers AI Run.
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Free/low-cost cloud inference fallbacks (optional)
# Cloudflare Workers AI is the canonical default; these keys are used only when CF
# is rate-limited or the requested model is not available. Keep them empty to skip.

# Groq — free tier: 14.4K requests/day, 30 RPM for text models
# https://console.groq.com/keys
GROQ_API_KEY=

# Together AI — free FLUX.1-schnell, plus $25 in signup credits for open models
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Pixazo — free FLUX.1-schnell image generation, 60 RPM, no daily cap
# https://api-console.pixazo.ai/
PIXAZO_API_KEY=

# OpenAI — only used when explicitly selected (paid; no free tier)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# NVIDIA NGC and Hugging Face for Stable Diffusion 3.5 NIM
# NVIDIA: 1,000 free inference requests/month for selected models
# HuggingFace Serverless Inference: $0.10/month free credit, exhausts quickly
NGC_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_KEY=

# =============================================================================
# SOCIAL MEDIA OAUTH CREDENTIALS
# Get these from each platform's developer console
# =============================================================================

# Twitter/X (OAuth 2.0)
# https://developer.twitter.com/en/portal/dashboard
# Free: 1,500 tweets/month write, no media upload. Media upload requires v1.1 with
# OAuth 1.0a app credentials (Basic $100+/mo for OAuth 2.0 media).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/twitter/callback

# Twitter v1.0a app credentials — required for image/media upload via v1.1 API
# Get from https://developer.twitter.com/en/portal/dashboard → Keys and Tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# TikTok (OAuth 2.0 + Content Posting API)
# https://developers.tiktok.com/
# Login Kit + Content Posting API required. Sandbox testers needed until app review.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/tiktok/callback

# LinkedIn (OAuth 2.0)
# https://www.linkedin.com/developers/
# Products required: "Share on LinkedIn", "Community Management API" and "Sign In with LinkedIn v3"
# Scopes used: openid profile email w_member_social w_organization_social r_organization_social r_organization_admin
# Fill these from your LinkedIn app → Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/linkedin/callback

# Instagram/Facebook (OAuth 2.0 via Meta)
# https://developers.facebook.com/
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/instagram/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/facebook/callback

# Threads (OAuth 2.0)
# https://developers.facebook.com/
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/threads/callback

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Public base URL where uploaded media is reachable (Instagram/TikTok pull from it).
# Example: https://yourdomain.com or an ngrok/Cloudflare Tunnel URL.
# Leave empty to disable image/video publishing on those platforms.
MEDIA_PUBLIC_BASE_URL=

# =============================================================================
# Cloudflare R2 (free 10 GB storage + egress) — optional but recommended.
# Without these, the media library falls back to local disk.
# Token: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write).
# Bucket name: the R2 bucket that stores team media.
# Public URL: custom domain or the bucket's default r2.dev URL.
# =============================================================================
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: override the S3-compatible endpoint. Defaults to
# https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com if empty.
R2_S3_ENDPOINT=

# ─── Cloudflare D1 (primary SQL databases, free tier) ───
# Create at: https://dash.cloudflare.com → Workers & Pages → D1
D1_SOCIAL_AUTOMATION_ID=
D1_N8N_ID=
D1_METABASE_ID=

# ─── Cloudflare KV (cache + queue, free tier) ───
KV_CACHE_NAMESPACE=
KV_QUEUE_NAMESPACE=

# ─── Cloudflare Vectorize (embeddings, free tier) ───
VECTORIZE_INDEX_NAME=social-embeddings

DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Social Automation Platform
APP_VERSION=0.1.0
APP_ENV=production
API_PREFIX=/api/v1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# Email digests → dedicated client mailbox tbaltzakis@cloudless.gr (omv-ha dovecot).
# Free path: Resend SMTP (same relay as omv-ha postfix). No AWS SES. No paid CF Email Sending.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@cloudless.gr
DIGEST_EMAIL_TO=tbaltzakis@cloudless.gr
DIGEST_EMAIL_ISSUES_ONLY=false
# Paid CF Email Sending (unused): EMAIL_PROVIDER=cloudflare + token below
CLOUDFLARE_EMAIL_API_TOKEN=

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Uncomment for local development without Docker
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social
# REDIS_URL=redis://localhost:6379/0
# N8N_URL=http://localhost:5678
# COMFYUI_URL=http://localhost:8000
# OLLAMA_URL=http://localhost:11434
# CHROMA_URL=http://localhost:8000