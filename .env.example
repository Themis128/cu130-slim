# =============================================================================
# CORE SERVICES - Database & Cache
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Metabase (uses same postgres instance)
METABASE_DB_USER=metabase
METABASE_DB_PASS=metabase_password
METABASE_DB_DBNAME=metabase
METABASE_DB_PORT=5432
MB_EMAIL=admin@example.com
MB_PASSWORD=metabase_admin_password
# Existing postgres_data volumes keep their initialized password. Change the
# password in PostgreSQL before updating this value on an existing deployment.

# Social Automation database (social-postgres service)
SOCIAL_POSTGRES_USER=social_user
SOCIAL_POSTGRES_PASSWORD=social_password
SOCIAL_POSTGRES_DB=social_automation
# Existing social_postgres_data volumes keep their initialized password. Change
# the password in PostgreSQL before updating this value on an existing deploy.

# N8N Workflow Engine
N8N_ENCRYPTION_KEY=your-32-char-encryption-key-here!!
N8N_USER=admin
N8N_PASSWORD=secure_password
N8N_API_KEY=

# Redis
REDIS_PASSWORD=redis_password

# =============================================================================
# AI SERVICES
# =============================================================================
COMFYUI_PORT=8000
OLLAMA_PORT=11434
CHROMA_PORT=8001

# MinIO (S3-compatible storage)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =============================================================================
# FRONTEND PORTS
# =============================================================================
PORTAL_PORT=3000
PORTAL_API_PORT=8080
ENV_MANAGER_PORT=8081
ENV_MANAGER_USER=admin
ENV_MANAGER_PASS=change_me

# =============================================================================
# SOCIAL AUTOMATION PLATFORM
# =============================================================================
# Security (generate with: openssl rand -base64 32)
SECRET_KEY=your-super-secret-key-min-32-chars
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars

# Admin user (for initial setup)
SOCIAL_ADMIN_EMAIL=admin@example.com
SOCIAL_ADMIN_PASSWORD=secure_admin_password
SOCIAL_ADMIN_NAME=Admin User

# Slack daily digest → #socialauto (C0BT263L17U)
# Create Incoming Webhook: Slack → Apps → Incoming Webhooks → add to #socialauto
SLACK_WEBHOOK_URL=
# Or use a bot token instead of webhook:
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0BT263L17U
SLACK_DIGEST_HOUR=9
SOCIALAUTO_DIGEST_DAYS=1

# Database
DATABASE_URL=postgresql+asyncpg://social_user:social_password@social-postgres:5432/social_automation

# Redis
REDIS_URL=redis://:redis_password@redis:6379/0

# Service URLs (internal Docker network)
N8N_URL=http://n8n:5678
COMFYUI_URL=http://comfyui:8000
OLLAMA_URL=http://ollama:11434
CHROMA_URL=http://chroma:8000
LOCAL_NIM_URL=http://stable-diffusion-nim:8000/v1/infer

# External AI APIs (optional)
FAL_KEY=
REPLICATE_API_TOKEN=

# Cloudflare Workers AI (LLM, image gen, and Whisper speech-to-text)
# Token: https://dash.cloudflare.com/profile/api-tokens (Workers AI / AI:Run permissions)
# Account ID: dashboard → right sidebar → "Account ID"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# NVIDIA NGC and Hugging Face for Stable Diffusion 3.5 NIM
NGC_API_KEY=
HF_TOKEN=

# =============================================================================
# SOCIAL MEDIA OAUTH CREDENTIALS
# Get these from each platform's developer console
# =============================================================================

# Twitter/X (OAuth 2.0)
# https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/twitter/callback

# LinkedIn (OAuth 2.0)
# https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/linkedin/callback

# Instagram/Facebook (OAuth 2.0 via Meta)
# https://developers.facebook.com/
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/instagram/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/facebook/callback

# Threads (OAuth 2.0)
# https://developers.facebook.com/
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth/threads/callback

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Social Automation Platform
APP_VERSION=0.1.0
API_PREFIX=/api

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# Email digests → dedicated client mailbox tbaltzakis@cloudless.gr (omv-ha dovecot).
# Free path: Resend SMTP (same relay as omv-ha postfix). No AWS SES. No paid CF Email Sending.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@cloudless.gr
DIGEST_EMAIL_TO=tbaltzakis@cloudless.gr
DIGEST_EMAIL_ISSUES_ONLY=false
# Paid CF Email Sending (unused): EMAIL_PROVIDER=cloudflare + token below
CLOUDFLARE_EMAIL_API_TOKEN=

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Uncomment for local development without Docker
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social
# REDIS_URL=redis://localhost:6379/0
# N8N_URL=http://localhost:5678
# COMFYUI_URL=http://localhost:8000
# OLLAMA_URL=http://localhost:11434
# CHROMA_URL=http://localhost:8000