{
  "name": "SocialAuto Automation Plan → scheduled posts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "sched-plan",
      "name": "Daily 07:00 Athens",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "socialauto-automation-plan",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-plan",
      "name": "Manual Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        140
      ],
      "webhookId": "socialauto-automation-plan"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = ($env.SOCIAL_TOTP_SECRET || '').trim().replace(/\\s+/g, '').toUpperCase();\nconst ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';\nconst clean = secret.replace(/=+$/, '');\nlet bits = 0, value = 0;\nconst bytes = [];\nfor (const ch of clean) {\n  const idx = ALPHABET.indexOf(ch);\n  if (idx === -1) throw new Error('Invalid base32 char in SOCIAL_TOTP_SECRET');\n  value = (value << 5) | idx;\n  bits += 5;\n  if (bits >= 8) { bytes.push((value >>> (bits - 8)) & 0xff); bits -= 8; }\n}\nconst key = Buffer.from(bytes);\nconst msg = Buffer.alloc(8);\nmsg.writeBigUInt64BE(BigInt(Math.floor(Date.now() / 30000)));\nconst digest = crypto.createHmac('sha1', key).update(msg).digest();\nconst offset = digest[digest.length - 1] & 0x0f;\nconst otp = ((digest.readUInt32BE(offset) & 0x7fffffff) % 1000000).toString().padStart(6, '0');\nreturn [{ json: { otp } }];"
      },
      "id": "totp-plan",
      "name": "Generate TOTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/auth/login' }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $env.SOCIAL_ADMIN_EMAIL }}"
            },
            {
              "name": "password",
              "value": "={{ $env.SOCIAL_ADMIN_PASSWORD }}"
            },
            {
              "name": "otp",
              "value": "={{ $('Generate TOTP').item.json.otp }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "login-plan",
      "name": "Login Social API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-token",
              "leftValue": "={{ $json.access_token }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-login",
      "name": "Login OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/ops/automation-plan' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "fetch-plan",
      "name": "Fetch Automation Plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Explode the plan into one item per dispatchable action.\nconst plan = $json || {};\nconst actions = Array.isArray(plan.actions) ? plan.actions : [];\nconst out = [];\nfor (const a of actions) {\n  if (!a.webhook || !a.schedule_at) continue;   // needs a pipeline + a slot\n  if (new Date(a.schedule_at).getTime() <= Date.now()) continue; // never schedule backwards\n  out.push({ json: {\n    webhook: a.webhook,\n    platform: a.platform, format: a.format,\n    schedule_at: a.schedule_at, time_local: a.time_local,\n    topic: a.instruction,\n    source: 'automation-plan', target_date: plan.target_date\n  }});\n}\nif (!out.length) out.push({ json: { webhook: null, skipped: true, reason: 'no dispatchable actions' } });\nreturn out;"
      },
      "id": "explode-actions",
      "name": "Explode Actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-webhook",
              "leftValue": "={{ $json.webhook }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-dispatchable",
      "name": "Dispatchable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.N8N_INTERNAL_URL || 'http://n8n:5678') + '/webhook/' + $json.webhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"topic\": {{ JSON.stringify($json.topic) }},\n  \"scheduled_at\": {{ JSON.stringify($json.schedule_at) }},\n  \"publish\": false,\n  \"source\": \"automation-plan\"\n}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "dispatch",
      "name": "Dispatch to Platform Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        -140
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sent = items.filter(i => !i.json.skipped).length;\nreturn [{ json: {\n  plan_date: $('Fetch Automation Plan').item.json.target_date || null,\n  dispatched: sent, skipped: items.length - sent,\n  llm_used: $('Fetch Automation Plan').item.json.llm_used || false\n} }];"
      },
      "id": "summarize",
      "name": "Summarize Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "err1",
              "name": "ok",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "err2",
              "name": "error",
              "value": "social_api_login_failed",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "login-failed",
      "name": "Login Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        140
      ]
    }
  ],
  "connections": {
    "Daily 07:00 Athens": {
      "main": [
        [
          {
            "node": "Generate TOTP",
            "type": "main",
            "index": 0
          }
