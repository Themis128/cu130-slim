          }
        ]
      ]
    },
    "Dispatchable?": {
      "main": [
        [
          {
            "node": "Dispatch to Platform Webhook",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Summarize Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch to Platform Webhook": {
      "main": [
        [
          {
            "node": "Summarize Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Athens",
    "executionTimeout": 1500,
    "errorWorkflow": "notify-failures"
  },
  "id": "socialauto-automation-plan"
}
