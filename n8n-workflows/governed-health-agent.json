{
  "id": "governed-health-agent",
  "name": "Governed Health Agent — stack probe + human gate",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 * * *"
            }
          ]
        }
      },
      "id": "sched-health-agent",
      "name": "Daily 08:30 Athens",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "governed-health-agent",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-health-agent",
      "name": "Manual Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        160
      ],
      "webhookId": "governed-health-agent"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json: {contract: {agent: 'governed-health-agent', intent: 'Observe stack health; escalate degraded state to a human', goal: 'Detect ACTION_NEEDED stack state within one scheduled window', scope: {read: ['stack-ops /status', 'social-api /health'], write: ['slack alerts channel']}, forbidden: ['container restarts', 'config changes', 'social posting', 'any write outside the alerts channel'], success: 'verdict computed; Slack alert iff DEGRADED or ACTION_NEEDED', human_gate: 'Slack alert -> human decides remediation. The agent never self-heals.'}}}];"
      },
      "id": "intent-contract",
      "name": "Intent Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        80
      ]
    },
    {
      "parameters": {
        "url": "http://stack-ops:8787/status",
        "options": {
          "timeout": 10000
        }
      },
      "id": "probe-stackops",
      "name": "Probe stack-ops",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        80
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "url": "={{$env.SOCIAL_API_URL}}/health",
        "options": {
          "timeout": 10000
        }
      },
      "id": "probe-api",
      "name": "Probe social-api",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        80
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const contract = $('Intent Contract').first().json.contract;\nconst so = $('Probe stack-ops').first().json || {};\nconst api = $('Probe social-api').first().json || {};\n// Only unambiguous bad states count — a managed service showing\n// 'exited'/'stopped' is asleep by design (stack-ops), not down.\nconst BAD = ['dead', 'error', 'unhealthy', 'restarting'];\nconst services = (so && typeof so === 'object') ? so : {};\nconst down = [];\nfor (const [name, s] of Object.entries(services)) {\n  const st = ((s && s.state) || '').toLowerCase();\n  if (BAD.some(b => st.includes(b))) down.push(name + ' (' + st + ')');\n}\nconst apiBody = JSON.stringify(api).slice(0, 400);\nconst apiOk = /\"status\"\\s*:\\s*\"ok\"|ok|healthy/i.test(apiBody) && !api.error;\nlet verdict = 'HEALTHY';\nif (!apiOk || down.length >= 3) verdict = 'ACTION_NEEDED';\nelse if (down.length >= 1) verdict = 'DEGRADED';\nreturn [{json: {verdict, api_ok: apiOk, down, managed_checked: Object.keys(services).length, agent: contract.agent, ts: new Date().toISOString()}}];"
      },
      "id": "evaluate",
      "name": "Evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-healthy",
              "leftValue": "={{ $json.verdict }}",
              "rightValue": "HEALTHY",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "healthy-check",
      "name": "Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SLACK_BOT_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "={{$env.SLACK_ALERTS_CHANNEL_ID}}"
            },
            {
              "name": "text",
              "value": "=*Stack health: {{$json.verdict}}* (governed-health-agent)\n• down services: {{$json.down.join(', ') || 'none'}}\n• api_ok: {{$json.api_ok}}\n• human gate: decide remediation — agent takes no action"
            }
          ]
        },
        "options": {}
      },
      "id": "slack-alert",
      "name": "Slack alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $('Evaluate').first().json;\nconsole.log('[governed-health-agent] verdict=' + e.verdict + ' down=' + (e.down || []).join(',') + ' api_ok=' + e.api_ok);\nreturn [{json: e}];"
      },
      "id": "log-run",
      "name": "Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        80
      ]
    }
  ],
  "connections": {
    "Daily 08:30 Athens": {
      "main": [
        [
          {
            "node": "Intent Contract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Webhook": {
      "main": [
        [
          {
            "node": "Intent Contract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Intent Contract": {
      "main": [
        [
          {
            "node": "Probe stack-ops",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Probe stack-ops": {
      "main": [
        [
          {
            "node": "Probe social-api",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Probe social-api": {
      "main": [
        [
          {
            "node": "Evaluate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate": {
      "main": [
        [
          {
            "node": "Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Healthy?": {
      "main": [
        [
          {
            "node": "Log",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Slack alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack alert": {
      "main": [
        [
          {
            "node": "Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionTimeout": 300,
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Governed health-check agent (Shift.Forward() AX Pass pilot): declares an intent contract per run, probes stack-ops + social-api read-only, evaluates deterministically, Slack-alerts a human on DEGRADED/ACTION_NEEDED. The agent never self-heals — the human gate is the remediation path."
  },
  "tags": [
    {
      "name": "governance"
    },
    {
      "name": "agent-pilot"
    },
    {
      "name": "ops"
    }
  ],
  "active": false
}