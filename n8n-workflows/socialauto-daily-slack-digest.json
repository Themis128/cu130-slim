{
  "id": "socialauto-daily-slack-digest",
  "name": "SocialAuto Daily Digest \u2192 #socialauto",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "sched-daily-digest",
      "name": "Daily 09:00 Athens",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "socialauto-daily-digest",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-daily-digest",
      "name": "Manual Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "socialauto-daily-digest"
    },
    {
      "parameters": {
        "jsCode": "const body = ($json.body && typeof $json.body === 'object') ? $json.body : {};\nconst days = Number(body.days || $env.SOCIALAUTO_DIGEST_DAYS || 1);\nconst post = body.post_to_slack === false ? false : true;\nreturn [{ json: { days: Math.max(1, Math.min(30, days || 1)), post_to_slack: post } }];"
      },
      "id": "resolve-digest-config",
      "name": "Resolve Digest Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/auth/login' }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $env.SOCIAL_ADMIN_EMAIL }}"
            },
            {
              "name": "password",
              "value": "={{ $env.SOCIAL_ADMIN_PASSWORD }}"
            },
            {
              "name": "otp",
              "value": "={{ $('Generate TOTP').item.json.otp }}"
            }
          ]
        },
        "options": {}
      },
      "id": "login-social-api",
      "name": "Login Social API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/ops/daily-digest?days=' + $('Resolve Digest Config').item.json.days + '&post_to_slack=' + $('Resolve Digest Config').item.json.post_to_slack }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "call-daily-digest",
      "name": "Run Daily Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $('Run Daily Digest').item.json;\nconst reports = r.reports || [];\nconst first = reports[0] || {};\nconst md = (first.markdown || '').trim();\nconst date = new Date().toISOString().slice(0, 10);\nconst body = md.replace(/\\*([^*\\n]+)\\*/g, '**$1**');\nconst basic = Buffer.from(($env.NEXTCLOUD_USERNAME || '') + ':' + ($env.NEXTCLOUD_APP_PASSWORD || '')).toString('base64');\nreturn [{\n  json: {\n    pageId: `socialauto-digest-${date}`,\n    title: `SocialAuto Digest \u2014 ${date}`,\n    markdown: body,\n    basic: `Basic ${basic}`,\n  }\n}];"
      },
      "id": "format-intravox-digest",
      "name": "Format IntraVox Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-digest",
              "leftValue": "={{ $json.markdown }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-intravox-digest",
      "name": "Has Digest?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.cloudless.gr/apps/intravox/api/pages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OCS-APIRequest",
              "value": "true"
            },
            {
              "name": "Authorization",
              "value": "={{ $('Format IntraVox Digest').item.json.basic }}"
            }
          ]
        },
        "sendBody": true,
        "jsonBody": "={\n  \"id\": {{ JSON.stringify($json.pageId) }},\n  \"title\": {{ JSON.stringify($json.title) }},\n  \"language\": \"en\",\n  \"parentPath\": \"en/news/updates\"\n}",
        "options": {
          "timeout": 30000
        },
        "specifyBody": "json"
      },
      "id": "create-intravox-page",
      "name": "Create IntraVox Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1420,
        80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const created = $json;\nconst fmt = $('Format IntraVox Digest').item.json;\nif (!created.uniqueId) {\n  return [{ json: { uniqueId: null, pageJson: null, create_error: created.error || created.message || 'no uniqueId' } }];\n}\nconst page = {\n  uniqueId: created.uniqueId,\n  title: fmt.title,\n  language: 'en',\n  layout: {\n    columns: 1,\n    rows: [\n      { columns: 1, backgroundColor: 'var(--color-primary-element)', widgets: [\n        { type: 'heading', column: 1, order: 1, content: fmt.title, level: 1 },\n        { type: 'text', column: 1, order: 2, content: fmt.markdown },\n      ]},\n    ],\n  },\n};\nreturn [{ json: { uniqueId: created.uniqueId, pageJson: JSON.stringify(page) } }];"
      },
      "id": "build-intravox-update",
      "name": "Build IntraVox Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        80
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://cloud.cloudless.gr/apps/intravox/api/pages/{{ $json.uniqueId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OCS-APIRequest",
              "value": "true"
            },
            {
              "name": "Authorization",
              "value": "={{ $('Format IntraVox Digest').item.json.basic }}"
            }
          ]
        },
        "sendBody": true,
        "jsonBody": "={{ $json.pageJson }}",
        "options": {
          "timeout": 30000
        },
        "specifyBody": "json"
      },
      "id": "update-intravox-content",
      "name": "Update IntraVox Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1860,
        80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $('Run Daily Digest').item.json;\nconst reports = r.reports || [];\nconst first = reports[0] || {};\nlet intravox = null;\ntry {\n  const upd = $('Update IntraVox Content').item.json;\n  intravox = upd.uniqueId ? `page ${upd.uniqueId}` : (upd.error || 'failed');\n} catch (e) {\n  intravox = $('Format IntraVox Digest').item.json.markdown ? 'failed' : 'skipped-empty';\n}\nreturn [{\n  json: {\n    ok: true,\n    message: r.message || '',\n    posted_to_slack: !!first.posted_to_slack,\n    slack_error: first.slack_error || null,\n    issue_count: (first.issues || []).length,\n    team_name: first.team_name || null,\n    intravox: intravox,\n  }\n}];"
      },
      "id": "summarize",
      "name": "Summarize Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = ($env.SOCIAL_TOTP_SECRET || '').trim().replace(/\\s+/g, '').toUpperCase();\nconst ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';\nconst clean = secret.replace(/=+$/, '');\nlet bits = 0, value = 0;\nconst bytes = [];\nfor (const ch of clean) {\n  const idx = ALPHABET.indexOf(ch);\n  if (idx === -1) throw new Error('Invalid base32 char in SOCIAL_TOTP_SECRET');\n  value = (value << 5) | idx;\n  bits += 5;\n  if (bits >= 8) { bytes.push((value >>> (bits - 8)) & 0xff); bits -= 8; }\n}\nconst key = Buffer.from(bytes);\nconst msg = Buffer.alloc(8);\nmsg.writeBigUInt64BE(BigInt(Math.floor(Date.now() / 30000)));\nconst digest = crypto.createHmac('sha1', key).update(msg).digest();\nconst offset = digest[digest.length - 1] & 0x0f;\nconst otp = ((digest.readUInt32BE(offset) & 0x7fffffff) % 1000000).toString().padStart(6, '0');\nreturn [{ json: { otp } }];"
      },
      "id": "6df812b1-38c9-4117-a2eb-ab7efabb8aab",
      "name": "Generate TOTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        240
      ]
    }
  ],
