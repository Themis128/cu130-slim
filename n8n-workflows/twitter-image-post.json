{
  "id": "twitter-image-post",
  "name": "Twitter/X Image Post (DMR caption + CF image)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "twitter-image-post",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-twitter-image",
      "name": "Manual Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "twitter-image-post"
    },
    {
      "parameters": {
        "jsCode": "const body = ($json.body && typeof $json.body === 'object') ? $json.body : {};\nconst topic = body.topic || body.prompt || 'cloudless.gr serverless services';\nconst accountId = body.account_id || null;\nconst imagePrompt = body.image_prompt || topic;\nconst publish = body.publish === false ? false : true;\nreturn [{ json: { topic, account_id: accountId, image_prompt: imagePrompt, platform: 'twitter', publish } }];"
      },
      "id": "resolve-config",
      "name": "Resolve Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/auth/login' }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "username", "value": "={{ $env.SOCIAL_ADMIN_EMAIL }}" },
            { "name": "password", "value": "={{ $env.SOCIAL_ADMIN_PASSWORD }}" }
          ]
        },
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      },
      "id": "login",
      "name": "Login Social API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "id": "has-token", "leftValue": "={{ $json.access_token }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-logged-in",
      "name": "Login OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/ai/generate-content' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.access_token }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": {{ JSON.stringify($('Resolve Config').item.json.topic) }},\n  \"platform\": \"twitter\",\n  \"tone\": \"concise\",\n  \"length\": \"short\",\n  \"include_hashtags\": true,\n  \"include_emojis\": true,\n  \"provider\": \"dmr\"\n}",
        "options": { "timeout": 120000, "response": { "response": { "neverError": true } } }
      },
      "id": "generate-tweet",
      "name": "Generate Tweet (DMR)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, -100],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/ai/generate-image' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Login Social API').item.json.access_token }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": {{ JSON.stringify($('Resolve Config').item.json.image_prompt) }},\n  \"provider\": \"cloudflare\",\n  \"model\": \"@cf/black-forest-labs/flux-1-schnell\"\n}",
        "options": { "timeout": 180000, "response": { "response": { "neverError": true } } }
      },
      "id": "generate-image",
      "name": "Generate Image (CF FLUX)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, -100],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Resolve Config').item.json;\nconst tweet = $('Generate Tweet (DMR)').item.json;\nconst img = $json;\nreturn [{ json: { account_id: cfg.account_id, platform: 'twitter', publish: cfg.publish, content_text: tweet.content || '', hashtags: tweet.hashtags || [], asset_id: img.asset_id || null } }];"
      },
      "id": "merge-results",
      "name": "Merge Tweet + Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/publishing/queue' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Login Social API').item.json.access_token }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content_text\": {{ JSON.stringify($json.content_text) }},\n  \"hashtags\": {{ JSON.stringify($json.hashtags) }},\n  \"platform\": \"twitter\",\n  \"account_id\": {{ JSON.stringify($json.account_id) }},\n  \"media_asset_ids\": {{ $json.asset_id ? JSON.stringify([$json.asset_id]) : '[]' }},\n  \"publish_now\": {{ $json.publish }}\n}",
        "options": { "timeout": 60000, "response": { "response": { "neverError": true } } }
      },
      "id": "queue-post",
      "name": "Queue Twitter Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, -100],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json;\nconst ok = !!(raw && (raw.id || raw.post_id));\nreturn [{ json: { ok, platform: 'twitter', post_type: 'image', post_id: raw.id || raw.post_id || null, status: raw.status || (ok ? 'queued' : 'failed'), error: ok ? null : (raw.detail || raw.message || 'queue_failed') } }];"
      },
      "id": "normalize",
      "name": "Normalize Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, -100]
    },
    {
      "parameters": {
        "assignments": { "assignments": [{ "id": "ok", "name": "ok", "value": false, "type": "boolean" }, { "id": "error", "name": "error", "value": "social_api_login_failed", "type": "string" }, { "id": "platform", "name": "platform", "value": "twitter", "type": "string" }] },
        "options": {}
      },
      "id": "login-failed",
      "name": "Login Failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, 120]
    }
  ],
  "connections": {
    "Manual Webhook": { "main": [[{ "node": "Resolve Config", "type": "main", "index": 0 }]] },
    "Resolve Config": { "main": [[{ "node": "Login Social API", "type": "main", "index": 0 }]] },
    "Login Social API": { "main": [[{ "node": "Login OK?", "type": "main", "index": 0 }]] },
    "Login OK?": { "main": [[{ "node": "Generate Tweet (DMR)", "type": "main", "index": 0 }], [{ "node": "Login Failed", "type": "main", "index": 0 }]] },
    "Generate Tweet (DMR)": { "main": [[{ "node": "Generate Image (CF FLUX)", "type": "main", "index": 0 }]] },
    "Generate Image (CF FLUX)": { "main": [[{ "node": "Merge Tweet + Image", "type": "main", "index": 0 }]] },
    "Merge Tweet + Image": { "main": [[{ "node": "Queue Twitter Post", "type": "main", "index": 0 }]] },
    "Queue Twitter Post": { "main": [[{ "node": "Normalize Result", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Athens", "executionTimeout": 600, "saveManualExecutions": true, "saveDataErrorExecution": "all", "saveDataSuccessExecution": "all" },
  "staticData": null,
  "tags": [{ "name": "twitter" }, { "name": "image" }, { "name": "dmr" }],
  "pinData": {}
}
