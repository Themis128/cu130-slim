        "jsonBody": "={\n  \"content_text\": {{ JSON.stringify($('Generate Carousel (DMR→CF)').item.json.suggested_caption || '') }},\n  \"hashtags\": {{ JSON.stringify($('Generate Carousel (DMR→CF)').item.json.hashtags || []) }},\n  \"target_account_ids\": {{ JSON.stringify([$('Resolve Config').item.json.account_id]) }},\n  \"media_ids\": {{ JSON.stringify($('Generate Carousel (DMR→CF)').item.json.media_ids || []) }}\n}",
        "options": {
          "timeout": 60000
        }
      },
