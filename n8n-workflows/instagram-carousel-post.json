    {
      "parameters": {
        "jsCode": "const body = ($json.body && typeof $json.body === 'object') ? $json.body : {};\nconst topic = body.topic || body.prompt || 'cloudless.gr serverless services';\nconst accountId = body.account_id || $env.CLOUDLESS_INSTAGRAM_ACCOUNT_ID || '38ddbd44-8811-4d0b-be62-a23fd2f50490';\nconst numSlides = Math.max(2, Math.min(10, Number(body.num_slides || 5)));\nconst tone = body.tone || 'conversational';\nconst publish = body.publish === false ? false : true;\nreturn [{ json: { topic, account_id: accountId, num_slides: numSlides, tone, platform: 'instagram', publish } }];"
      },
      "id": "resolve-config",
      "name": "Resolve Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
