        "jsCode": "const raw = $json;\nconst ok = !!(raw && raw.id);\nreturn [{ json: { ok, platform: 'instagram', post_type: 'carousel', post_id: raw.id || null, status: raw.status || (ok ? 'draft' : 'failed'), error: ok ? null : (raw.detail || raw.message || 'carousel_failed') } }];"
