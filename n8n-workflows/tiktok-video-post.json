        "jsonBody": "={{ JSON.stringify({\n  \"prompt\": \"Write ONE single-sentence cinematic video scene prompt (max 40 words) for an AI text-to-video model, as a vertical background clip for a TikTok about: \" + $('Resolve Config').item.json.topic + \". Describe only visuals: subject, motion, lighting, mood. No text, no logos, no people facing camera.\",\n  \"platform\": \"tiktok\",\n  \"tone\": \"descriptive\",\n  \"length\": \"short\",\n  \"include_hashtags\": false,\n  \"include_emojis\": false\n}) }}",
