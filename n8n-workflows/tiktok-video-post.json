    {
      "parameters": {
        "jsCode": "const cfg = $('Resolve Config').item.json;\nconst scene = $('Generate Video Prompt (DMR)').item.json.content || 'clouds drifting over a calm blue sea, soft sunlight';\nconst seed = cfg.seed || Math.floor(Math.random() * 1e15);\nconst graph = {\n  \"1\": {\"class_type\": \"UnetLoaderGGUF\", \"inputs\": {\"unet_name\": \"ltx-video-2b-v0.9-Q8_0.gguf\"}},\n  \"2\": {\"class_type\": \"CLIPLoader\", \"inputs\": {\"clip_name\": \"t5xxl_fp8_e4m3fn_scaled.safetensors\", \"type\": \"ltxv\"}},\n  \"3\": {\"class_type\": \"VAELoader\", \"inputs\": {\"vae_name\": \"LTX-Video-VAE-BF16.safetensors\"}},\n  \"4\": {\"class_type\": \"CLIPTextEncode\", \"inputs\": {\"text\": \"cinematic vertical shot, \" + scene, \"clip\": [\"2\", 0]}},\n  \"5\": {\"class_type\": \"CLIPTextEncode\", \"inputs\": {\"text\": \"worst quality, inconsistent motion, blurry, jittery, distorted, watermark, text\", \"clip\": [\"2\", 0]}},\n  \"6\": {\"class_type\": \"LTXVConditioning\", \"inputs\": {\"positive\": [\"4\", 0], \"negative\": [\"5\", 0], \"frame_rate\": cfg.frame_rate}},\n  \"14\": {\"class_type\": \"EmptyLTXVLatentVideo\", \"inputs\": {\"width\": cfg.width, \"height\": cfg.height, \"length\": cfg.num_frames, \"batch_size\": 1}},\n  \"15\": {\"class_type\": \"KSampler\", \"inputs\": {\"model\": [\"1\", 0], \"positive\": [\"6\", 0], \"negative\": [\"6\", 1], \"latent_image\": [\"14\", 0], \"seed\": seed, \"steps\": cfg.steps, \"cfg\": cfg.cfg, \"sampler_name\": \"euler\", \"scheduler\": \"normal\", \"denoise\": 1.0}},\n  \"13\": {\"class_type\": \"VAEDecode\", \"inputs\": {\"samples\": [\"15\", 0], \"vae\": [\"3\", 0]}},\n  \"12\": {\"class_type\": \"VHS_VideoCombine\", \"inputs\": {\"frame_rate\": cfg.frame_rate, \"loop_count\": 0, \"filename_prefix\": \"n8n-tiktok\", \"format\": \"video/h264-mp4\", \"pix_fmt\": \"yuv420p\", \"crf\": 19, \"save_metadata\": false, \"pingpong\": false, \"save_output\": true, \"images\": [\"13\", 0]}}\n};\nreturn [{ json: { body: JSON.stringify({ prompt: graph }) } }];"
      },
