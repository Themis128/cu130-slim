{
  "name": "Weekly Cloud Computing Post",
  "active": false,
  "id": "weekly-cloud-computing-post",
  "nodes": [
    {
      "name": "Weekly Monday 09:00 Athens",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "typeVersion": 1.2,
      "id": "5e822793-f148-4120-8ec8-fdcfcbda1be9"
    },
    {
      "name": "Resolve Weekly Post Config",
      "type": "n8n-nodes-base.code",
      "position": [
        280,
        0
      ],
      "parameters": {
        "jsCode": "const body = ($json.body && typeof $json.body === 'object') ? $json.body : {};\nreturn [{\n  json: {\n    title: body.title || 'Weekly Cloud Computing Trends',\n    description: body.description || 'Stay up-to-date on the latest cloud computing trends and technologies.',\n    link: body.link || 'https://cloudless.gr/blog',\n    type: body.type || 'post',\n    target_account_id: body.target_account_id || $env.CLOUDLESS_LINKEDIN_ORG_ACCOUNT_ID || '9c4451bb-e820-489f-8676-76ddbc788ffe',\n    publish: body.publish === false ? false : true,\n  }\n}];"
      },
      "typeVersion": 2,
      "id": "13e7bf8b-87b8-466d-970b-22a44ef484d4"
    },
    {
      "name": "Login Social API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/auth/login' }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $env.SOCIAL_ADMIN_EMAIL }}"
            },
            {
              "name": "password",
              "value": "={{ $env.SOCIAL_ADMIN_PASSWORD }}"
            },
            {
              "name": "otp",
              "value": "={{ $('Generate TOTP').item.json.otp }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "typeVersion": 4.2,
      "id": "ea377717-7c6b-4b6d-97a6-8b47e4ac422a",
      "onError": "continueRegularOutput"
    },
    {
      "name": "Login OK?",
      "type": "n8n-nodes-base.if",
      "position": [
        740,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-token",
              "leftValue": "={{ $json.access_token }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "typeVersion": 2.2,
      "id": "9870e3e4-fd73-414e-93c4-66e9318ac786"
    },
    {
      "name": "Run Weekly Post",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        980,
        -140
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/content/posts' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content_text\": {{ JSON.stringify($('Resolve Weekly Post Config').item.json.title + '\\n\\n' + $('Resolve Weekly Post Config').item.json.description) }},\n  \"link_url\": {{ JSON.stringify($('Resolve Weekly Post Config').item.json.link) }},\n  \"target_account_ids\": {{ JSON.stringify([$('Resolve Weekly Post Config').item.json.target_account_id]) }}\n}",
        "options": {
          "timeout": 120000
        }
      },
      "typeVersion": 4.2,
      "id": "9d4f3d5e-ec30-4a74-97bc-7ba4ebdf8820",
      "onError": "continueRegularOutput"
    },
    {
      "name": "Publish?",
      "type": "n8n-nodes-base.if",
      "position": [
        1220,
        -140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "should-publish",
              "leftValue": "={{ String($('Resolve Weekly Post Config').item.json.publish) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "has-post-id",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "typeVersion": 2.2,
      "id": "publish-if-9c2e"
    },
    {
      "name": "Publish Now",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1460,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SOCIAL_API_URL || 'http://social-api:8000') + '/api/v1/content/posts/' + $json.id + '/publish-now' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Login Social API').item.json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "typeVersion": 4.2,
      "id": "publish-now-7f1a",
      "onError": "continueRegularOutput"
    },
    {
      "name": "Normalize Result",
      "type": "n8n-nodes-base.code",
      "position": [
        1700,
        -140
      ],
      "parameters": {
        "jsCode": "const raw = $json;\nconst ok = !!(raw && raw.id);\nreturn [{\n  json: {\n    ok,\n    brand: 'cloudless.gr',\n    post_id: raw.id || null,\n    status: raw.status || (ok ? 'created' : 'failed'),\n    error: ok ? null : (raw.message || raw.detail || raw.error || 'post_creation_failed'),\n  }\n}];"
      },
      "typeVersion": 2,
      "id": "0d298c35-5103-41b2-91eb-7aba9940a842"
    },
    {
      "name": "Login Failed",
      "type": "n8n-nodes-base.set",
      "position": [
        980,
        140
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "ok",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "error",
              "name": "error",
              "value": "social_api_login_failed",
              "type": "string"
            },
            {
              "id": "hint",
              "name": "hint",
              "value": "Check SOCIAL_ADMIN_EMAIL / SOCIAL_ADMIN_PASSWORD on the n8n container",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 3.4,
      "id": "fdbd62f8-2a25-4026-a4c9-6cf21760e6d8"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = ($env.SOCIAL_TOTP_SECRET || '').trim().replace(/\\s+/g, '').toUpperCase();\nconst ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';\nconst clean = secret.replace(/=+$/, '');\nlet bits = 0, value = 0;\nconst bytes = [];\nfor (const ch of clean) {\n  const idx = ALPHABET.indexOf(ch);\n  if (idx === -1) throw new Error('Invalid base32 char in SOCIAL_TOTP_SECRET');\n  value = (value << 5) | idx;\n  bits += 5;\n  if (bits >= 8) { bytes.push((value >>> (bits - 8)) & 0xff); bits -= 8; }\n}\nconst key = Buffer.from(bytes);\nconst msg = Buffer.alloc(8);\nmsg.writeBigUInt64BE(BigInt(Math.floor(Date.now() / 30000)));\nconst digest = crypto.createHmac('sha1', key).update(msg).digest();\nconst offset = digest[digest.length - 1] & 0x0f;\nconst otp = ((digest.readUInt32BE(offset) & 0x7fffffff) % 1000000).toString().padStart(6, '0');\nreturn [{ json: { otp } }];"
      },
      "id": "6118600a-14f1-47df-b622-65ef067261ba",
      "name": "Generate TOTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        140
      ]
    }
  ],
