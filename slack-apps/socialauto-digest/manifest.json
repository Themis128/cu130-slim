{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "SocialAuto Digest",
    "description": "Daily/weekly digests to #socialauto; warnings/errors to #socialauto-alerts",
    "background_color": "#0B1220"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "SocialAuto Digest",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/digest",
        "description": "Trigger SocialAuto digest now",
        "should_escape": false
      }
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": []
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
