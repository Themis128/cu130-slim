        "-e",
        "SOCIALAUTO_URL=http://social-api:8000",
        "social-api",
        "python3",
        "-m",
        "app.mcp.server"
      ],
      "cwd": "/home/tbaltzakis/cu130-slim"
    },
    "tiktok-console": {
