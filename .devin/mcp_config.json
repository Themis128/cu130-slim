{
  "mcpServers": {
    "playwright": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--health-cmd",
        "node -e 'process.exit(require(\"fs\").readdirSync(\"/proc\").some(d=>/^\\d+$/.test(d)&&require(\"fs\").readFileSync(\"/proc/\"+d+\"/cmdline\",\"utf8\").includes(\"cli.js\"))?0:1)'",
        "--health-interval",
        "30s",
        "--health-timeout",
        "10s",
        "--health-retries",
        "3",
        "--label",
        "com.cloudless.managed-by=mcp",
        "--label",
        "com.cloudless.mcp-server=playwright",
        "--network",
        "host",
        "--shm-size=2g",
        "-v",
        "C:/Users/tbaltzakis/cu130-slim:/workspace",
        "-v",
        "C:/Users/tbaltzakis/cu130-slim/.playwright-data:/home/pwuser/.playwright-data",
        "-w",
        "/workspace",
        "--cpus",
        "2",
        "--memory",
        "2g",
        "mcr.microsoft.com/playwright/mcp:v0.0.82",
        "--config",
        "/workspace/.playwright-data/pw-mcp-config.json",
        "--user-data-dir",
        "/home/pwuser/.playwright-data/profile",
        "--browser",
        "chromium",
        "--init-script",
        "/workspace/.playwright-data/init-script.js",
        "--ignore-https-errors",
        "--timeout-action",
        "15000",
        "--timeout-navigation",
        "120000",
        "--timeout-settle",
        "1500"
      ]
    },
    "dmr": {
