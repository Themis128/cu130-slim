{
  "mcpServers": {
    "playwright": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--network",
        "host",
        "--shm-size=2g",
        "-v",
        "/home/tbaltzakis/cu130-slim:/workspace",
        "-v",
        "/home/tbaltzakis/cu130-slim/.playwright-data:/home/pwuser/.playwright-data",
        "-w",
        "/workspace",
        "mcr.microsoft.com/playwright/mcp:latest",
        "--config",
        "/workspace/.playwright-data/pw-mcp-config.json",
        "--user-data-dir",
        "/home/pwuser/.playwright-data/profile",
        "--browser",
        "chromium",
        "--init-script",
        "/workspace/.playwright-data/init-script.js",
        "--ignore-https-errors",
        "--timeout-action",
        "15000",
        "--timeout-navigation",
        "120000",
        "--timeout-settle",
        "1500"
      ]
    },
    "github-local": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "export GITHUB_PERSONAL_ACCESS_TOKEN=\"${GITHUB_PERSONAL_ACCESS_TOKEN:-$(python3 -c 'import json; print(json.load(open(\"/home/tbaltzakis/cu130-slim/.devin/mcp_config.local.json\"))[\"mcpServers\"][\"github-local\"][\"env\"][\"GITHUB_PERSONAL_ACCESS_TOKEN\"])' 2>/dev/null)}\"; exec /home/tbaltzakis/.local/bin/node /home/tbaltzakis/.local/share/pnpm/global/5/node_modules/@modelcontextprotocol/server-github/dist/index.js"
      ]
    },
    "dmr": {
      "command": "python3",
      "args": [
        "/home/tbaltzakis/cu130-slim/.devin/skills/docker-model-runner/scripts/dmr-mcp-server.py"
      ]
    },
    "socialauto": {
      "command": "docker",
      "args": [
        "compose",
        "exec",
        "-T",
        "-e",
        "SOCIALAUTO_URL=http://social-api:8000",
        "social-api",
        "python3",
        "-m",
        "app.mcp.server"
      ],
      "cwd": "/home/tbaltzakis/cu130-slim"
    },
    "tiktok-console": {
      "command": "python3",
      "args": [
        "/home/tbaltzakis/cu130-slim/.cursor/skills/tiktok-console-ops/scripts/tiktok-console-mcp-server.py"
      ],
      "cwd": "/home/tbaltzakis/cu130-slim",
      "env": {
        "CU130_ROOT": "/home/tbaltzakis/cu130-slim"
      }
    },
    "n8n": {
      "command": "python3",
      "args": [
        "/home/tbaltzakis/cu130-slim/.devin/skills/n8n-cloudless/scripts/n8n-mcp-server.py"
      ],
      "cwd": "/home/tbaltzakis/cu130-slim"
    },
    "cloudflare-docs": {
      "command": "/home/tbaltzakis/.local/bin/node",
      "args": [
        "/home/tbaltzakis/.local/lib/mcp-remote/node_modules/mcp-remote/dist/proxy.js",
        "https://docs.mcp.cloudflare.com/mcp"
      ],
      "disabled": true
    },
    "cloudflare": {
      "command": "python3",
      "args": [
        "/home/tbaltzakis/cu130-slim/.devin/skills/cloudflare-token-ops/scripts/cf-mcp-server.py"
      ],
      "cwd": "/home/tbaltzakis/cu130-slim"
    }
  }
}