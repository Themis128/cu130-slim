FROM node:22-alpine

WORKDIR /app

RUN apk update && apk upgrade --available

# Install deps from package.json only — source is volume-mounted at runtime
COPY package*.json ./
RUN npm ci --legacy-peer-deps --omit=dev

# Remove bundled npm/corepack; they are not needed at runtime and carry
# CVE-heavy packages such as tar and sigstore.
RUN rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm \
           /usr/local/bin/npx \
           /usr/local/bin/corepack

EXPOSE 8083

CMD ["node", "./node_modules/next/dist/bin/next", "dev", "--hostname", "0.0.0.0", "--port", "8083"]
